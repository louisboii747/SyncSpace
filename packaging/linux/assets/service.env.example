# Optional SyncSpace user-service overrides.
#
# Copy this file to:
#   ${XDG_CONFIG_HOME:-$HOME/.config}/syncspace/service.env
# Then apply it with:
#   syncspace restart
#
# Keep one KEY=value pair per line. This file is parsed by systemd rather than
# a shell. SYNCSPACE_HOST must remain a loopback address; the server refuses to
# start if a LAN-facing management address is supplied.

SYNCSPACE_HOST=127.0.0.1
SYNCSPACE_PORT=8384
SYNCSPACE_PEER_HOST=0.0.0.0
SYNCSPACE_PEER_PORT=8385

# The default data location is ${XDG_CONFIG_HOME:-$HOME/.config}/SyncSpace.
# Use an absolute path if you need to move it. Environment variables and ~ are
# not expanded inside this file.
# SYNCSPACE_DATA_DIR=/home/example/.local/share/syncspace
