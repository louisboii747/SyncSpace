#!/bin/sh
set -eu

service_name="syncspace.service"
package_version="@VERSION@"
default_port="8384"

print_help() {
  cat <<'EOF'
SyncSpace manages a private file-transfer service for your user account.

Usage:
  syncspace [open]       Start SyncSpace and open its local interface
  syncspace start        Start SyncSpace for this login session
  syncspace stop         Stop SyncSpace
  syncspace restart      Restart SyncSpace and apply configuration changes
  syncspace status       Show service status
  syncspace logs         Follow service logs
  syncspace enable       Start now and automatically at future logins
  syncspace disable      Stop now and disable automatic login startup
  syncspace --version    Show the installed package version
  syncspace --help       Show this help

The interface is available only from this computer. By default it opens at
http://127.0.0.1:8384. Nearby devices use the separate encrypted peer port.
EOF
}

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
environment_file="$config_home/syncspace/service.env"

management_port() {
  port=$default_port
  if [ -r "$environment_file" ]; then
    candidate=$(sed -n 's/^[[:space:]]*SYNCSPACE_PORT[[:space:]]*=[[:space:]]*\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$environment_file" | tail -n 1)
    case "$candidate" in
      '') ;;
      *[!0-9]*) ;;
      *)
        if [ "$candidate" -ge 1 ] 2>/dev/null && [ "$candidate" -le 65535 ] 2>/dev/null; then
          port=$candidate
        fi
        ;;
    esac
  fi
  printf '%s\n' "$port"
}

require_user_systemd() {
  if ! command -v systemctl >/dev/null 2>&1; then
    printf '%s\n' "SyncSpace needs systemd user services, but systemctl was not found." >&2
    exit 1
  fi
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    printf '%s\n' "The systemd user service is not available in this session." >&2
    printf '%s\n' "Sign in through a normal desktop session and try again." >&2
    exit 1
  fi
}

reload_units() {
  systemctl --user daemon-reload
}

wait_until_ready() {
  url=$1
  attempts=0
  while [ "$attempts" -lt 40 ]; do
    if command -v curl >/dev/null 2>&1; then
      if curl --fail --silent --show-error --max-time 1 "$url/api/v1/privacy-policy" >/dev/null 2>&1; then
        return 0
      fi
    elif command -v wget >/dev/null 2>&1; then
      if wget --quiet --timeout=1 --output-document=/dev/null "$url/api/v1/privacy-policy" >/dev/null 2>&1; then
        return 0
      fi
    else
      sleep 1
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 0.25
  done
  return 1
}

open_browser() {
  url=$1
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
  elif command -v gio >/dev/null 2>&1; then
    gio open "$url" >/dev/null 2>&1 &
  else
    printf '%s\n' "SyncSpace is running. Open $url in a browser."
  fi
}

command=${1:-open}
case "$command" in
  open)
    require_user_systemd
    reload_units
    systemctl --user start "$service_name"
    url="http://127.0.0.1:$(management_port)"
    if ! wait_until_ready "$url"; then
      printf '%s\n' "SyncSpace did not become ready. Run 'syncspace status' for details." >&2
      exit 1
    fi
    open_browser "$url"
    ;;
  start)
    require_user_systemd
    reload_units
    systemctl --user start "$service_name"
    printf '%s\n' "SyncSpace started. Run 'syncspace open' to open it."
    ;;
  stop)
    require_user_systemd
    systemctl --user stop "$service_name"
    ;;
  restart)
    require_user_systemd
    reload_units
    systemctl --user restart "$service_name"
    ;;
  status)
    require_user_systemd
    systemctl --user status "$service_name"
    ;;
  logs)
    require_user_systemd
    if ! command -v journalctl >/dev/null 2>&1; then
      printf '%s\n' "journalctl was not found on this system." >&2
      exit 1
    fi
    exec journalctl --user --unit "$service_name" --follow
    ;;
  enable)
    require_user_systemd
    reload_units
    systemctl --user enable --now "$service_name"
    printf '%s\n' "SyncSpace will now start when you sign in."
    ;;
  disable)
    require_user_systemd
    systemctl --user disable --now "$service_name"
    printf '%s\n' "Automatic startup is disabled and SyncSpace has stopped."
    ;;
  --version|-V|version)
    printf 'SyncSpace %s\n' "$package_version"
    ;;
  --help|-h|help)
    print_help
    ;;
  *)
    printf "Unknown command: %s\n\n" "$command" >&2
    print_help >&2
    exit 2
    ;;
esac
