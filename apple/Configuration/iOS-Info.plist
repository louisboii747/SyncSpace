<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>SyncSpace</string>
  <key>UILaunchScreen</key><dict/>
  <key>NSLocalNetworkUsageDescription</key><string>SyncSpace finds and transfers files directly to devices on your local network.</string>
  <key>NSBonjourServices</key><array><string>_syncspace._tcp</string></array>
